Options -Indexes

# Uploaded business records are never public assets. They must be served by
# download.php, which checks the session, role, record status, and file path.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
